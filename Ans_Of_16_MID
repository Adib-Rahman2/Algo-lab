
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m, tc = 1;

    while (cin >> n >> m && (n != 0 || m != 0)) {
        vector<int> a(n), b(m);

        for (int i = 0; i < n; i++)
            cin >> a[i];

        for (int i = 0; i < m; i++)
            cin >> b[i];

        int dp[105][105] = {};

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (a[i - 1] == b[j - 1])
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                else
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }

        cout << "Twin Towers #" << tc++ << "\n";
        cout << "Number of Tiles : " << dp[n][m] << "\n\n";
    }

    return 0;
}
